#!/bin/sh
# pxmxfw: manage the firewall, DNS and DHCP of this container.
#
# Usage: pxmxfw COMMAND
#   apply              validate the config, set addresses, load the firewall,
#                      update dnsmasq (safe to run any number of times)
#   check              check kernel modules and container settings
#   status             show interfaces and service state
#   detect             add newly found network interfaces (as role=off)
#   render nft|dnsmasq print the generated config without applying it
#   validate KIND FILE check a config file (settings|interfaces|services|forwards|hosts)
#   firstboot          one-time setup on the first container start
#
# Settings live in /etc/pxmxfw. The web UI edits the same files, so they can
# also be managed with Ansible, Puppet or git: write them, then "pxmxfw apply".

set -eu
set -f  # config lines are split into words; never expand globs in them

PXMXFW_LIB=${PXMXFW_LIB:-/usr/lib/pxmxfw}
. "$PXMXFW_LIB/lib.sh"

RULESET=$PXMXFW_ETC/ruleset.nft
IFACES=$PXMXFW_ETC/interfaces
NFT_MAIN=${PXMXFW_NFT_MAIN:-/etc/nftables.nft}
FIRSTBOOT_DONE=$PXMXFW_ETC/.firstboot-done

die() { echo "pxmxfw: $*" >&2; exit 1; }
have_rc() { command -v rc-service >/dev/null 2>&1; }
sysctl_set() { # path value (under /proc/sys), best effort
	[ "$(cat "$PXMXFW_PROCSYS/$1" 2>/dev/null)" = "$2" ] || echo "$2" 2>/dev/null > "$PXMXFW_PROCSYS/$1" || true
}

load() { config_load || die "invalid configuration in $PXMXFW_ETC (see above)"; }

cmd_render() {
	load
	case ${1:-nft} in
		nft) render_nft ;;
		dnsmasq) render_dnsmasq ;;
		*) die "render: nft or dnsmasq" ;;
	esac
}

# ---- addresses --------------------------------------------------------------
# Interfaces with addr=proxmox are left to Proxmox (it writes
# /etc/network/interfaces on every start). pxmxfw sets the others itself, so
# Proxmox rewriting that file never undoes them.

# set_addrs IFACE FAMILY WANT: make WANT (or nothing for "none") the only
# global address of FAMILY (4 or 6) on IFACE
set_addrs() {
	have=$(ip -"$2" -o addr show dev "$1" 2>/dev/null |
		awk '$4 !~ /^fe80:/ { print $4 }')
	for a in $have; do
		[ "$a" = "$3" ] || ip -"$2" addr del "$a" dev "$1" || true
	done
	case $3 in none|'') ;; *)
		case " $have " in *" $3 "*) ;; *) ip -"$2" addr add "$3" dev "$1" ;; esac
	esac
}

_a_iface() { # name role addr addr6 dhcp comment
	[ -e "$PXMXFW_SYSNET/$1" ] || return 0
	[ "$2" = off ] && return 0
	ip link set dev "$1" up 2>/dev/null || true
	[ "$3" = proxmox ] || set_addrs "$1" 4 "$3" || echo "pxmxfw: could not set $3 on $1" >&2
	if [ "$IPV6" = yes ] && [ "$4" != proxmox ]; then
		set_addrs "$1" 6 "$4" || echo "pxmxfw: could not set $4 on $1" >&2
	fi
}

apply_system() {
	ifaces_each "$IFACES" _a_iface
	sysctl_set net/ipv4/ip_forward 1
	if [ "$IPV6" = yes ]; then
		sysctl_set net/ipv6/conf/all/forwarding 1
		# keep taking router advertisements on WAN while forwarding
		sysctl_set "net/ipv6/conf/$WAN_IF/accept_ra" 2
	else
		sysctl_set net/ipv6/conf/all/forwarding 0
	fi
}

cmd_apply() {
	load
	[ "${1:-}" = --boot ] || apply_system

	tmp=$RULESET.new
	render_nft > "$tmp"
	# Check the candidate with the same wrapper nftables uses at boot
	wrap=$(mktemp)
	trap 'rm -f "$wrap" "$tmp"' EXIT
	sed "s|$RULESET|$tmp|" "$NFT_MAIN" > "$wrap"
	nft -c -f "$wrap" || die "nftables rejected the new ruleset; nothing changed (run: pxmxfw check)"
	mv "$tmp" "$RULESET"
	[ "${1:-}" = --boot ] && return 0  # the nftables service loads it next
	nft -f "$NFT_MAIN" || die "loading $NFT_MAIN failed"
	echo "firewall: loaded"

	if [ "$DNSMASQ" = yes ]; then
		render_dnsmasq > "$PXMXFW_DNSMASQ_CONF"
		if have_rc; then
			rc-update add dnsmasq default >/dev/null 2>&1 || true
			rc-service dnsmasq restart >/dev/null 2>&1 || die "dnsmasq failed to start (see /var/log/messages)"
		fi
		echo "dnsmasq: running"
	else
		rm -f "$PXMXFW_DNSMASQ_CONF"
		if have_rc; then
			if rc-service -q dnsmasq status 2>/dev/null; then rc-service dnsmasq stop >/dev/null 2>&1 || true; fi
			rc-update del dnsmasq default >/dev/null 2>&1 || true
		fi
		echo "dnsmasq: disabled"
	fi

	# Move the web UI when its port or address changed. Delayed and
	# detached so a request from the UI itself still gets its answer.
	if have_rc && rc-service -q pxmxfw-webui status 2>/dev/null &&
		[ "$(cmd_webui_listen 2>/dev/null)" != "$(cat /run/pxmxfw/webui.listen 2>/dev/null)" ]; then
		echo "web UI: restarting on $(cmd_webui_listen 2>/dev/null)"
		(sleep 2; rc-service pxmxfw-webui restart) </dev/null >/dev/null 2>&1 &
	fi
}

# ---- interface detection ------------------------------------------------------
# New interfaces (a NIC added in Proxmox, later a WireGuard tunnel) are added
# with role=off, so nothing reaches or leaves through them until they are
# given a role in the web UI.

detect_line() { # IFACE ROLE: a new interfaces line, noting what Proxmox set
	line="$1 role=$2"
	case $(proxmox_method "$1") in
		static|dhcp) ;;
		*) line="$line addr=none" ;;
	esac
	case $(proxmox_method "$1" inet6) in
		static|dhcp|auto) ;;
		*) line="$line addr6=none" ;;
	esac
	echo "$line"
}

cmd_detect() {
	[ -e "$IFACES" ] || : > "$IFACES"
	known=$(awk '!/^[[:space:]]*(#|$)/ { print $1 }' "$IFACES")
	for i in $(present_ifaces); do
		case " $(echo $known) " in *" $i "*) continue ;; esac
		detect_line "$i" off >> "$IFACES"
		echo "found new interface $i (role=off)"
	done
}

# ---- first boot -----------------------------------------------------------
# Proxmox writes /etc/network/interfaces, /etc/hostname, /etc/hosts and
# /etc/resolv.conf on every container start, so this never touches them. It
# only derives pxmxfw's own defaults from what Proxmox configured: eth0 (net0)
# is the WAN, eth1 (net1) the LAN, any other NIC starts switched off.

cmd_firstboot() {
	[ -e "$FIRSTBOOT_DONE" ] && { echo "first boot setup already done"; return 0; }
	settings_load || die "invalid settings in $PXMXFW_ETC/pxmxfw.conf"

	{
		echo "# Network interfaces. eth0 (net0 in Proxmox) is the WAN."
		echo "# IFACE role=wan|lan|isolated|off [addr=proxmox|none|IP/PREFIX] [addr6=...] [dhcp=START-END]"
		wan=
		for i in $(present_ifaces); do
			if [ -z "$wan" ] && [ "$i" = eth0 ]; then
				wan=$i
				echo "eth0 role=wan"
			elif [ "$i" = eth1 ]; then
				line=$(detect_line eth1 lan)
				if addr=$(proxmox_address eth1) && range=$(dhcp_range_for "$addr"); then
					line="$line dhcp=$range"
					echo "pxmxfw: LAN eth1 is $addr, DHCP range $range (dnsmasq stays off until enabled)" >&2
				fi
				echo "$line"
			else
				detect_line "$i" off
			fi
		done
		[ -n "$wan" ] || echo "eth0 role=wan"
	} > "$IFACES.new"
	mv "$IFACES.new" "$IFACES"

	if ! grep -q 'role=lan' "$IFACES"; then
		# Single NIC: keep the web UI reachable on WAN to finish the setup;
		# it asks for the root password.
		echo "pxmxfw: no LAN interface yet, web UI allowed on WAN" >&2
		WEBUI_WAN=yes
		settings_write > "$PXMXFW_ETC/pxmxfw.conf.new"
		mv "$PXMXFW_ETC/pxmxfw.conf.new" "$PXMXFW_ETC/pxmxfw.conf"
	fi
	touch "$FIRSTBOOT_DONE"
}

# Boot: first boot setup, pick up new NICs, set addresses, write the ruleset
# the nftables service loads right after.
cmd_boot() {
	cmd_firstboot
	cmd_detect
	load
	apply_system
	cmd_apply --boot
}

# ---- checks ---------------------------------------------------------------
# A container shares the Proxmox host's kernel and cannot load modules
# itself, so each feature the ruleset needs is probed, and a failure names
# the modules to load on the host.
#
# Output: one line per check, tab separated: STATUS ID TITLE DETAIL HINT
# STATUS is ok, warn or fail. HINT may name modules as "modules:a b c".

_check() { printf '%s\t%s\t%s\t%s\t%s\n' "$@"; }

module_loaded() { grep -q "^$1 " /proc/modules 2>/dev/null || [ -d "/sys/module/$1" ]; }

# probe ID TITLE MODULES NFT_BODY: test a kernel feature with "nft -c"
_probe() {
	f=$(mktemp)
	printf 'table inet pxmxfw_probe {\n%s\n}\n' "$4" > "$f"
	if nft -c -f "$f" >/dev/null 2>&1; then
		_check ok "$1" "$2" "available ($3)" ""
	else
		missing=
		for m in $3; do module_loaded "$m" || missing="$missing $m"; done
		missing=${missing# }
		_check fail "$1" "$2" "not available, module(s) not loaded: ${missing:-$3}" "modules:${missing:-$3}"
	fi
	rm -f "$f"
}

_c_iface() { # name role addr addr6 dhcp comment
	[ "$2" = off ] && return 0
	if [ -e "$PXMXFW_SYSNET/$1" ]; then
		a=$(iface_ipv4 "$1")
		if [ -z "$a" ] && [ "$2" != wan ]; then
			_check warn "if_$1" "Interface $1 ($2)" "no IPv4 address" \
				"Give it an address in the web UI (Interfaces) or in Proxmox."
		else
			_check ok "if_$1" "Interface $1 ($2)" "present${a:+, $a}" ""
		fi
	else
		n=${1#eth}
		case $n in *[!0-9]*|'') n=N ;; esac
		_check fail "if_$1" "Interface $1 ($2)" "missing" \
			"Add it in Proxmox: pct set CTID -net$n name=$1,bridge=vmbrX"
	fi
}

cmd_check() {
	config_load 2>/dev/null || _check fail config "Configuration" "invalid" "Run: pxmxfw apply, and fix what it reports."

	if ! command -v nft >/dev/null 2>&1; then
		_check fail nft "nftables tool" "nft not installed" "apk add nftables"
	elif ! out=$(nft list tables 2>&1); then
		_check fail netadmin "Network admin rights" "$(printf '%s' "$out" | head -n1)" \
			"The container needs CAP_NET_ADMIN. Remove net_admin from any lxc.cap.drop line in /etc/pve/lxc/CTID.conf."
	else
		_check ok netadmin "Network admin rights" "nft can talk to the kernel" ""
		_probe nftables "nftables core" "nf_tables" \
			'chain c { type filter hook input priority filter; policy accept; }'
		_probe conntrack "Connection tracking" "nf_conntrack nft_ct" \
			'chain c { type filter hook input priority filter; ct state established accept; }'
		_probe masq "NAT (masquerade)" "nf_nat nft_chain_nat nft_masq" \
			'chain c { type nat hook postrouting priority srcnat; meta nfproto ipv4 masquerade; }'
		_probe dnat "Port forwarding (DNAT)" "nf_nat nft_chain_nat nft_nat" \
			'chain c { type nat hook prerouting priority dstnat; meta nfproto ipv4 tcp dport 1 dnat ip to 192.0.2.1:1; }'
	fi

	if module_loaded wireguard; then
		_check ok wireguard "WireGuard" "available (wireguard)" ""
	else
		_check warn wireguard "WireGuard" "module not loaded (only needed for tunnels)" "modules:wireguard"
	fi

	if [ "$(cat "$PXMXFW_PROCSYS/net/ipv4/ip_forward" 2>/dev/null)" = 1 ]; then
		_check ok ip_forward "IPv4 forwarding" "enabled" ""
	else
		_check fail ip_forward "IPv4 forwarding" "disabled" \
			"Click Apply. If it stays off, add \"lxc.sysctl.net.ipv4.ip_forward = 1\" to /etc/pve/lxc/CTID.conf on the host and restart the container."
	fi
	if [ "$IPV6" = yes ]; then
		if [ "$(cat "$PXMXFW_PROCSYS/net/ipv6/conf/all/forwarding" 2>/dev/null)" = 1 ]; then
			_check ok ip6_forward "IPv6 forwarding" "enabled" ""
		else
			_check fail ip6_forward "IPv6 forwarding" "disabled" \
				"Click Apply. If it stays off, add \"lxc.sysctl.net.ipv6.conf.all.forwarding = 1\" to /etc/pve/lxc/CTID.conf on the host and restart the container."
		fi
	fi

	ifaces_each "$IFACES" _c_iface 2>/dev/null || true
	[ -n "$IN_IFS" ] || _check warn inside "LAN side" "no interface with role lan or isolated" \
		"Add a second network device in Proxmox (pct set CTID -net1 name=eth1,bridge=vmbr1,ip=192.168.10.1/24), then give it a role in the web UI."

	if nft list table inet pxmxfw >/dev/null 2>&1; then
		_check ok firewall "Firewall rules" "loaded" ""
	else
		_check fail firewall "Firewall rules" "not loaded" "Fix the failed checks above, then click Apply (or run: pxmxfw apply)."
	fi

	if [ "$DNSMASQ" = yes ]; then
		if pidof dnsmasq >/dev/null 2>&1; then
			_check ok dnsmasq "DNS/DHCP (dnsmasq)" "running" ""
		else
			_check fail dnsmasq "DNS/DHCP (dnsmasq)" "enabled but not running" "Check /var/log/messages, then click Apply."
		fi
	else
		_check ok dnsmasq "DNS/DHCP (dnsmasq)" "disabled" ""
	fi
}

# Print the host commands that load every module a failed check names.
host_modules_hint() {
	mods=$(cut -f5 | sed -n 's/^modules://p' | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ')
	mods=${mods% }
	[ -n "$mods" ] || return 0
	cat <<-EOF

	On the Proxmox host (as root), load the missing modules and keep them after a reboot:
	  modprobe -a $mods
	  printf '%s\n' $mods >> /etc/modules-load.d/pxmxfw.conf
	Then restart this container: pct reboot CTID
	EOF
}

cmd_check_human() {
	res=$(cmd_check)
	printf '%s\n' "$res" | while IFS='	' read -r st _id title detail hint; do
		printf '%-5s %-34s %s\n' "$st" "$title" "$detail"
		case $hint in ''|modules:*) ;; *) [ "$st" = ok ] || printf '      %s\n' "$hint" ;; esac
	done
	printf '%s\n' "$res" | awk -F '\t' '$1 != "ok"' | host_modules_hint
}

# ---- status ---------------------------------------------------------------

_s_iface() { # name role addr addr6 dhcp comment
	if [ -e "$PXMXFW_SYSNET/$1" ]; then st=present; else st=missing; fi
	pm=$(proxmox_method "$1"); pm6=$(proxmox_method "$1" inet6)
	echo "iface=$1 $2 $st ${pm:--} ${pm6:--}"
}

cmd_status() {
	config_load 2>/dev/null || true
	echo "version=$(cat /usr/share/pxmxfw/VERSION 2>/dev/null || echo dev)"
	echo "hostname=$(hostname)"
	echo "alpine=$(cat /etc/alpine-release 2>/dev/null)"
	echo "uptime=$(awk '{ printf "%d\n", $1 }' /proc/uptime)"
	echo "wan_if=$WAN_IF"
	echo "ipv6=$IPV6"
	if nft list table inet pxmxfw >/dev/null 2>&1; then echo firewall=active; else echo firewall=inactive; fi
	if pidof dnsmasq >/dev/null 2>&1; then echo dnsmasq=running
	elif [ "$DNSMASQ" = yes ]; then echo dnsmasq=stopped
	else echo dnsmasq=disabled; fi
	echo "ip_forward=$(cat "$PXMXFW_PROCSYS/net/ipv4/ip_forward" 2>/dev/null)"
	if [ -e "$FIRSTBOOT_DONE" ]; then echo firstboot=done; else echo firstboot=pending; fi
	# iface=NAME ROLE present|missing PROXMOX_V4 PROXMOX_V6
	ifaces_each "$IFACES" _s_iface 2>/dev/null || true
	# addr=NAME ADDRESS/PREFIX for every address in the container
	ip -o addr show 2>/dev/null | awk '$2 != "lo" && $4 !~ /^fe80:/ { print "addr=" $2 " " $4 }'
}

# Listen address for the web UI: the first lan address, or all addresses
# when the UI is allowed on WAN (the firewall still limits who reaches it).
cmd_webui_listen() {
	config_load 2>/dev/null || true
	if [ "$WEBUI_WAN" = yes ]; then
		echo "$WEBUI_PORT"
		return
	fi
	for i in $LAN_IFS $ISO_IFS; do
		a=$(iface_ipv4 "$i")
		[ -z "$a" ] || { echo "$a:$WEBUI_PORT"; return; }
	done
	echo "pxmxfw: no LAN address, web UI on localhost only" >&2
	echo "127.0.0.1:$WEBUI_PORT"
}

case ${1:-help} in
	apply) cmd_apply ;;
	boot) cmd_boot ;;
	check) if [ "${2:-}" = --tsv ]; then cmd_check; else cmd_check_human; fi ;;
	status) cmd_status ;;
	detect) cmd_detect ;;
	render) cmd_render "${2:-nft}" ;;
	validate) [ $# -eq 3 ] || die "usage: pxmxfw validate KIND FILE"; validate "$2" "$3" ;;
	firstboot) cmd_firstboot ;;
	webui-listen) cmd_webui_listen ;;
	help|-h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command: $1 (try: pxmxfw help)" ;;
esac
