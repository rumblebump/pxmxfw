#!/sbin/openrc-run
# pxmxfw web UI (pxmxfw-webui, HTTPS). It listens on the LAN address only
# (see WEBUI_PORT and WEBUI_WAN in /etc/pxmxfw/pxmxfw.conf).

description="pxmxfw web UI"
supervisor=supervise-daemon
command=/usr/sbin/pxmxfw-webui
output_log=/var/log/pxmxfw-webui.log
error_log=/var/log/pxmxfw-webui.log

depend() {
	need net
	after nftables pxmxfw
}

start_pre() {
	listen=$(/usr/sbin/pxmxfw webui-listen) || return 1
	mkdir -p /run/pxmxfw
	echo "$listen" > /run/pxmxfw/webui.listen
	command_args="-listen $listen"
	einfo "Web UI on https://$listen"
}
