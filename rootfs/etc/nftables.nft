#!/usr/sbin/nft -f
# Loaded by the nftables service at boot and by "pxmxfw apply".
# The pxmxfw rules are generated from /etc/pxmxfw; change them in the web UI
# or in those files, then run "pxmxfw apply". Put hand-written extra rules in
# /etc/nftables.d/*.nft.

flush ruleset

include "/etc/pxmxfw/ruleset.nft"
include "/etc/nftables.d/*.nft"
